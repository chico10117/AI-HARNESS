# Copy to .env (never commit the copy) and fill values locally or via the
# service manager / Paperclip secret references. Names only — no values here.

# --- Paperclip control plane (M2; see docs/decisions/0001-paperclip-version.md) ---
PAPERCLIP_VERSION=
PAPERCLIP_DATA_DIR=
PAPERCLIP_BASE_URL=
PAPERCLIP_BOARD_USER=
PAPERCLIP_DATABASE_URL=

# --- Agent identities (one scoped token each; Paperclip secret refs preferred) ---
PAPERCLIP_TOKEN_CHIEF_OF_STAFF=
PAPERCLIP_TOKEN_OPS=
PAPERCLIP_TOKEN_CTO=
PAPERCLIP_TOKEN_BACKEND_INFRA=
PAPERCLIP_TOKEN_BUILDER_DEBIAN=
PAPERCLIP_TOKEN_BUILDER_VPS=

# --- Runtime integrations (M3) ---
HERMES_API_KEY=
HERMES_BASE_URL=
OPENCLAW_GATEWAY_URL=
OPENCLAW_INVITE_TOKEN=

# --- Model providers (scoped per agent; least privilege) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tailnet bootstrap (decision 0002; one-shot, expire after use) ---
TAILSCALE_AUTH_KEY=
